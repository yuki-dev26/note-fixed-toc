{
    "manifest_version": 3,
    "name": "note Fixed ToC",
    "version": "1.2.0",
    "description": "note記事の目次を画面右下に固定表示します（非公式）",
    "homepage_url": "https://note.com/yuki_tech/n/ncf5c9d131418",
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "content_scripts": [
        {
            "matches": [
                "https://note.com/*"
            ],
            "js": [
                "src/modules/constants.js",
                "src/modules/utils.js",
                "src/modules/toc.js",
                "src/modules/floater.js",
                "src/modules/navigation.js",
                "src/main.js"
            ],
            "css": [
                "src/style.css"
            ],
            "run_at": "document_end"
        }
    ]
}